# AgentCleaner 环境变量配置示例
# 复制此文件内容并设置环境变量

# ========================================
# Agent类型配置
# ========================================
# 可选值: 'local' (本地模型) 或 'eas' (阿里云EAS API)
export AGENT_TYPE=local

# ========================================
# 本地模型配置（当AGENT_TYPE=local时使用）
# ========================================
# 主模型路径
export PRIMARY_MODEL=/mnt/data/huggingface_downloads/models/qwen/Qwen3-VL-30B-A3B-Thinking

# GPU配置
export CUDA_VISIBLE_DEVICES=0,1,2,3

# ========================================
# 阿里云EAS API配置（当AGENT_TYPE=eas时使用）
# ========================================
# EAS服务基础URL（请替换为你的实际URL）
export EAS_BASE_URL=http://your-eas-service.aliyuncs.com/api/predict/your-service-name

# EAS认证token（请替换为你的实际token）
export EAS_TOKEN=your-eas-token-here

# 模型名称
export EAS_MODEL_NAME=Qwen3-VL-235B-A22B-Instruct

# API配置
export EAS_MAX_TOKENS=256
export EAS_TIMEOUT=60

# ========================================
# 并发配置
# ========================================
# 本地模型推荐配置
# export NUM_PROCESSORS=8
# export BATCH_SIZE=4

# EAS API推荐配置（较低并发以避免限流）
# export NUM_PROCESSORS=4
# export BATCH_SIZE=2

export NUM_PROCESSORS=8
export BATCH_SIZE=4

# ========================================
# 使用方法
# ========================================
# source env.example  # 加载环境变量
# ./quick_start_eas.sh  # 运行脚本

